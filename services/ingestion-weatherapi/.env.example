APP_ENV=local

DB_HOST=ingestion-weatherapi-db
DB_PORT=5432
DB_NAME=ingestion_weatherapi_db
DB_USER=demo
DB_PASSWORD=demo

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=demo
RABBITMQ_PASSWORD=demo
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=weather.events
RABBITMQ_ROUTING_KEY=weather.snapshot.fetched

WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_KEY=your-weatherapi-key-here

SERVICE_NAME=ingestion-weatherapi
SOURCE_NAME=weatherapi

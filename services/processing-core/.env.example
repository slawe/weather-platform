APP_ENV=local
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080
SERVICE_NAME=processing-core

DB_HOST=processing-core-db
DB_PORT=5432
DB_NAME=processing_core_db
DB_USER=demo
DB_PASSWORD=demo

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=demo
RABBITMQ_PASSWORD=demo
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=weather.events
RABBITMQ_EXCHANGE_TYPE=topic

RABBITMQ_QUEUE=weather.processing
RABBITMQ_RETRY_QUEUE=weather.processing.retry
RABBITMQ_DLQ=weather.processing.dlq
RABBITMQ_ROUTING_KEY=weather.snapshot.fetched
RABBITMQ_RETRY_TTL_MS=5000
RABBITMQ_MAX_RETRIES=5

WEATHER_HISTORY_RETENTION_DAYS=90
WEATHER_HISTORY_RETENTION_CLEANUP_INTERVAL_HOURS=24

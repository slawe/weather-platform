UID=1000
GID=1000

# --------------------------------------------------
# RabbitMQ
# --------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=demo
RABBITMQ_PASSWORD=demo
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=weather.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=weather.snapshot.fetched

# --------------------------------------------------
# ingestion-weatherapi database
# --------------------------------------------------
INGESTION_WEATHERAPI_DB_HOST=ingestion-weatherapi-db
INGESTION_WEATHERAPI_DB_PORT=5432
INGESTION_WEATHERAPI_DB_NAME=ingestion_weatherapi_db
INGESTION_WEATHERAPI_DB_USER=demo
INGESTION_WEATHERAPI_DB_PASSWORD=demo

# --------------------------------------------------
# WeatherAPI provider
# --------------------------------------------------
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_KEY=

# --------------------------------------------------
# Service metadata
# --------------------------------------------------
INGESTION_WEATHERAPI_SERVICE_NAME=ingestion-weatherapi
INGESTION_WEATHERAPI_SOURCE_NAME=weatherapi

# --------------------------------------------------
# processing-core database
# --------------------------------------------------
PROCESSING_CORE_DB_HOST=processing-core-db
PROCESSING_CORE_DB_PORT=5432
PROCESSING_CORE_DB_NAME=processing_core_db
PROCESSING_CORE_DB_USER=demo
PROCESSING_CORE_DB_PASSWORD=demo

# --------------------------------------------------
# processing-core service
# --------------------------------------------------
PROCESSING_CORE_SERVICE_NAME=processing-core
PROCESSING_CORE_HISTORY_RETENTION_DAYS=90
RABBITMQ_QUEUE=weather.processing
RABBITMQ_RETRY_QUEUE=weather.processing.retry
RABBITMQ_DLQ=weather.processing.dlq
RABBITMQ_RETRY_TTL_MS=5000
RABBITMQ_MAX_RETRIES=5

# --------------------------------------------------
# weather-comparison service
# --------------------------------------------------
WEATHER_COMPARISON_SERVICE_NAME=weather-comparison
WEATHER_COMPARISON_PORT=3000
WEATHER_COMPARISON_PROCESSING_CORE_API_BASE_URL=http://processing-core:8080
